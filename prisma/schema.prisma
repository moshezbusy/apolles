generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum PasswordTokenPurpose {
  SET
  RESET
}

enum LedgerEntryType {
  TOPUP_BANK
  HOLD
  HOLD_RELEASE
  CHARGE
  REFUND
  PAYOUT
  ADJUSTMENT
}

model Agency {
  id                      String        @id @default(cuid())
  name                    String
  country                 String // ISO 3166-1 alpha-2
  status                  AccountStatus @default(ACTIVE)
  bankRefNo               Int           @unique @default(autoincrement())
  bankReference           String        @unique // e.g. "APL-1042"
  phone                   String? // business phone, set by the agent on /settings (shown on vouchers)
  email                   String? // business email, set by the agent on /settings (not a login email)
  // Client quote branding and defaults (mockup 20, plan 5d). Empty = the agency's own name,
  // phone and the quote creator's name.
  quoteDisplayName        String?
  quoteAdvisorName        String?
  quoteContactPhone       String?
  quoteAdvisorEmail       String?
  quoteBrandColor         String? // "#rrggbb"
  defaultQuoteLanguage    QuoteLanguage @default(EN)
  defaultQuoteMessage     String        @default("")
  defaultMarkupType       MarkupType    @default(PERCENT)
  defaultMarkupValue      Int           @default(0)
  defaultShowCancellation Boolean       @default(true)
  // "Your Apolles balance is low" was sent and the balance is still under USD 500 (email #19).
  lowBalanceAlerted       Boolean       @default(false)
  createdAt               DateTime      @default(now())

  users          User[]
  ledgerEntries  LedgerEntry[]
  logo           AgencyLogo?
  bookings       Booking[]
  clients        Client[]
  quotes         Quote[]
  application    AgencyApplication?
  recentSearches RecentSearch[]

  @@index([createdAt, id])
}

// A client of one agency (mockup 18, plan 5a). Personal data: only the agency that owns the row
// ever reads it (src/server/clients.ts scopes every query by agencyId), and the audit log records
// which fields changed, never their values.
model Client {
  id          String   @id @default(cuid())
  agencyId    String
  firstName   String
  lastName    String
  email       String? // stored lowercase
  phone       String // the WhatsApp number as typed
  phoneDigits String // the same number as digits only, without a leading 00 or 0, for search
  nationality String // ISO 3166-1 alpha-2
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency     Agency            @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  companions ClientCompanion[]
  quotes     Quote[]

  @@index([agencyId, updatedAt(sort: Desc), id(sort: Desc)])
}

// Someone who travels with a client. The client is always the lead traveler and is not stored
// here. childAge is null for an adult.
model ClientCompanion {
  id        String   @id @default(cuid())
  clientId  String
  firstName String
  lastName  String
  relation  String   @default("")
  childAge  Int?
  position  Int
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, position])
}

// The agency's logo, one per agency (src/server/agency-profile.ts). The bytes are PNG or JPEG,
// checked from their own header on upload (src/lib/image-info.ts); never SVG.
model AgencyLogo {
  agencyId  String   @id
  mimeType  String // "image/png" | "image/jpeg"
  data      Bytes
  sizeBytes Int
  width     Int
  height    Int
  sha256    String
  updatedAt DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
}

model User {
  id                String        @id @default(cuid())
  agencyId          String?
  role              Role
  email             String        @unique // always stored lowercase (see normalizeEmail)
  name              String
  passwordHash      String?
  failedLogins      Int           @default(0)
  lockedUntil       DateTime?
  // When the last sign-in attempt slot was taken (database clock, set by reserveAttempt). A row
  // at MAX_FAILED_LOGINS with no lock and an old reservation was left by a crashed request.
  attemptReservedAt DateTime?
  totpSecret        String? // base32; set by startTotpEnrollment (admins only)
  // Set once the admin proved the authenticator works; until then the secret can be replaced.
  totpConfirmedAt   DateTime?
  // Last accepted TOTP time step: a code is accepted only for a later step (no reuse).
  totpLastUsedStep  Int?
  status            AccountStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())

  agency               Agency?             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  sessions             Session[]
  passwordTokens       PasswordToken[]
  ledgerEntries        LedgerEntry[]
  auditLogs            AuditLog[]
  bookings             Booking[]
  bookingEvents        BookingEvent[]
  quotes               Quote[]
  reviewedApplications AgencyApplication[]
  recentSearches       RecentSearch[]

  @@index([agencyId])
}

model Session {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  userId         String
  expiresAt      DateTime
  // Admin sessions only: when the TOTP code was entered for this session. Null = not yet.
  totpVerifiedAt DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordToken {
  id        String               @id @default(cuid())
  tokenHash String               @unique
  userId    String
  purpose   PasswordTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LedgerEntry {
  id             String          @id @default(cuid())
  agencyId       String
  type           LedgerEntryType
  amountCents    Int
  currency       String          @default("USD")
  holdId         String?
  bookingRef     String?
  reason         String
  actorUserId    String?
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([agencyId, createdAt])
  @@index([holdId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId])
}

// Fixed-window request counters for rate limits (src/server/rate-limit.ts). One row per key
// and window; windowStart comes from the database clock. Keys hold an action and an IP, or a
// sha256 hash of an email, never a raw email. Rows older than 24 hours are pruned.
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int

  @@id([key, windowStart])
  @@index([windowStart])
}

// Every request to and response from a supplier (Expedia), for the site review and debugging
// (spec section 6, "supplier log"). Bodies have personal data masked (src/server/supplier/mask.ts)
// and are capped in size. Kept 90 days; the cleanup job comes with the background worker.
model SupplierCallLog {
  id                   String   @id @default(cuid())
  supplier             String // "expedia"
  method               String
  path                 String // path and query; never credentials
  status               Int? // null on a timeout or network error
  durationMs           Int
  affiliateReferenceId String?
  requestBody          Json?
  responseBody         Json?
  error                String? // "timeout" | "network" | null
  // Names (never values) of response fields the adapter did not know and dropped
  // (owner decision 2026-11-10, docs/decisions/2026-11-10-supplier-unknown-fields.md).
  unknownFields        String[] @default([])
  createdAt            DateTime @default(now())

  @@index([createdAt])
  @@index([affiliateReferenceId])
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// Background work (spec section 7: daily content refresh, reconciliation, emails, PDFs), run by
// the separate worker process (src/worker.ts). Claimed with FOR UPDATE SKIP LOCKED, so two
// workers never run the same job (src/server/jobs/queue.ts).
model Job {
  id         String    @id @default(cuid())
  kind       String
  payload    Json
  status     JobStatus @default(QUEUED)
  attempts   Int       @default(0)
  runAt      DateTime
  lockedAt   DateTime?
  lastError  String? // the error class and at most 500 characters, never a response body
  dedupeKey  String?   @unique
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status, runAt])
}

enum ContentSyncStatus {
  RUNNING
  DONE
  FAILED
}

// The local copy of Expedia's hotel list (spec section 7, "local hotel database"), refreshed
// daily from the catalog file (src/server/content/catalog-sync.ts). Only the countries in
// CONTENT_COUNTRIES are stored. Coordinates and star ratings are decimals, never floats.
model Property {
  id               String   @id // Expedia property id
  name             String
  city             String
  countryCode      String
  stateProvince    String?
  starRating       Decimal? @db.Decimal(2, 1)
  latitude         Decimal? @db.Decimal(9, 6)
  longitude        Decimal? @db.Decimal(9, 6)
  rank             Int?
  expediaCollect   Boolean
  active           Boolean  @default(true)
  catalogSeenRunId String
  updatedAt        DateTime @updatedAt

  @@index([active, expediaCollect, rank])
  @@index([countryCode, catalogSeenRunId])
}

// One run of a content sync job (catalog, regions, inactive), for auditing and for "since".
model ContentSyncRun {
  id         String            @id @default(cuid())
  kind       String
  status     ContentSyncStatus @default(RUNNING)
  startedAt  DateTime          @default(now())
  finishedAt DateTime?
  counts     Json?

  @@index([kind, status, startedAt])
}

// Destinations agents search by (cities and multi-city areas), from Rapid /regions, refreshed
// daily (src/server/content/regions-sync.ts). A prefix index on lower(name) for active rows is
// added in the migration's raw SQL.
model Destination {
  id            String   @id // Expedia region id
  name          String
  nameFull      String
  type          String // "city" | "multi_city_vicinity"
  countryCode   String
  propertyCount Int
  active        Boolean  @default(true)
  seenRunId     String
  updatedAt     DateTime @updatedAt

  @@index([countryCode, seenRunId])
}

// Which hotels are in which destination. No foreign key to Property: the two syncs run
// independently, and search joins only active Property rows.
model DestinationProperty {
  destinationId String
  propertyId    String

  @@id([destinationId, propertyId])
  @@index([propertyId])
}

// Hotel content (images, check-in, fees, policies) from Rapid /properties/content, cached for
// 24 hours; up to 7 days when Expedia is unavailable (src/server/content/content-cache.ts).
model PropertyContentCache {
  propertyId String   @id
  data       Json // PropertyContent (src/server/supplier/types.ts)
  fetchedAt  DateTime

  @@index([fetchedAt])
}

// A search an agent ran (plan 2b, task 6): the candidate hotels in rank order and how far the
// supplier calls got. Results are stored as a snapshot for 30 minutes, so filtering, sorting and
// paging never call Expedia again; the price is checked again before booking anyway. Every
// query is scoped by agencyId (no IDOR).
model SearchSnapshot {
  id           String        @id @default(cuid())
  agencyId     String
  userId       String
  query        Json
  candidateIds String[]
  nextIndex    Int           @default(0)
  createdAt    DateTime
  expiresAt    DateTime
  hotels       SearchHotel[]
  rates        SearchRate[]

  @@index([agencyId, createdAt])
  @@index([expiresAt])
}

// One priced hotel in a search snapshot: its cheapest total and all its offers (Offer[]).
model SearchHotel {
  snapshotId          String
  propertyId          String
  position            Int // rank order within the search ("recommended")
  name                String
  city                String
  starRating          Decimal?       @db.Decimal(2, 1)
  minTotalMinor       Int
  currency            String
  refundableAvailable Boolean
  offers              Json
  snapshot            SearchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, propertyId])
  @@index([snapshotId, position])
  @@index([snapshotId, minTotalMinor])
}

// One rate of a priced hotel in a search snapshot (plan 2c). The results filters (room name,
// free cancellation, price) match one rate on all of them, and the card shows the cheapest
// matching rate, so a hotel's "from" price is always a rate the agent can actually pick.
model SearchRate {
  snapshotId     String
  propertyId     String
  rateIndex      Int // position in SearchHotel.offers
  roomName       String // lowercased, for the room-name filter
  refundable     Boolean
  totalMinor     Int
  currency       String
  feesAtProperty Boolean // something is paid at the hotel on top of the total (BP4)
  snapshot       SearchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, propertyId, rateIndex])
  @@index([snapshotId, totalMinor])
}

// Booking states (spec section 5; plan 3). Changes go only through src/server/booking/states.ts,
// which updates conditionally inside a transaction and writes a BookingEvent row.
enum BookingStatus {
  DRAFT // guest details entered; nothing held, nothing sent
  PENDING_CONFIRMATION // money held; the supplier was asked (or its answer is not known yet)
  CONFIRMED // the supplier confirmed; the hold became a charge
  FAILED // the supplier refused, or reconciliation found no booking; the hold was released
  CANCEL_PENDING // the agent asked to cancel; waiting for the supplier
  CANCELLED // the supplier confirmed the cancellation; the refund is in the wallet
  CANCELLED_BY_SUPPLIER // cancelled by the supplier or the hotel (refund recorded by an admin)
  EXPIRED // a draft left too long; nothing was held
}

// One hotel booking of one agency (phase 1: one room). Money in integer minor units (USD).
// The price-check token and the supplier's links are server-only and never sent to a browser.
model Booking {
  id                      String        @id @default(cuid())
  reference               String        @unique // "APL-XXXXXXXX"; also the supplier's affiliate_reference_id (TR1)
  agencyId                String
  userId                  String
  status                  BookingStatus @default(DRAFT)
  snapshotId              String? // the search it came from (gone after cleanup)
  propertyId              String
  hotelName               String
  hotelCity               String
  roomId                  String
  roomName                String
  rateId                  String
  bedGroupId              String
  bedDescription          String
  checkin                 String // YYYY-MM-DD, the property's calendar date
  checkout                String
  adults                  Int
  childAges               Int[]
  leadGivenName           String
  leadFamilyName          String
  leadEmail               String
  leadPhone               String
  guests                  Json // [{ givenName, familyName }] for every guest, lead first
  refundable              Boolean
  totalMinor              Int // what the agency pays: the supplier's inclusive total (BP5)
  currency                String
  price                   Json // PriceBreakdown as last checked
  cancelPenalties         Json // CancelPenalty[]
  nonrefundableDateRanges Json
  priceCheckToken         String // from the search snapshot; server-only
  bookToken               String? // from the last price check; server-only
  priceCheckedAt          DateTime?
  previousTotalMinor      Int? // set when the last price check changed the price
  holdId                  String?
  chargedMinor            Int? // the amount held (then charged) when the agent booked; refunds come from it
  supplierItineraryId     String?
  supplierRoomId          String?
  supplierLinks           Json? // retrieve and cancel hrefs from the supplier; server-only
  hotelConfirmationId     String?
  cancelChargeMinor       Int?
  refundMinor             Int?
  failureReason           String?
  reconcileAttempts       Int           @default(0)
  lastNotFoundAt          DateTime?
  cancelRequestedAt       DateTime?
  needsAttention          Boolean       @default(false) // reconciliation gave up: an admin must look
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  confirmedAt             DateTime?
  cancelledAt             DateTime?

  // The quote and destination this booking was made from (plan 5d). When every destination with
  // a client pick has a confirmed booking, the quote is booked.
  quoteId              String?
  quoteStayId          String?
  // The agency's own selling price, for its reports only (plan 6): never charged, never on the
  // voucher. A markup on the charged total, as on quotes (percent in basis points, fixed in cents).
  sellMarkupType       MarkupType?
  sellMarkupValue      Int?
  // Requests sent to the hotel with the booking (not guaranteed; plan 8b). No personal details.
  specialRequest       String      @default("")
  // When free cancellation ends (the first charge starts), and when the 72-hour reminder went
  // out (email #14, plan 8c).
  freeCancelEndsAt     DateTime?
  freeCancelReminderAt DateTime?

  agency    Agency         @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  quote     Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  quoteStay QuoteStay?     @relation(fields: [quoteStayId], references: [id], onDelete: SetNull)
  events    BookingEvent[]

  @@index([agencyId, createdAt])
  @@index([quoteId])
  @@index([quoteStayId, status])
  @@index([status, freeCancelEndsAt])
  @@index([agencyId, status, checkin])
  @@index([status, updatedAt])
  @@index([needsAttention])
}

// The audit trail of a booking: one row per state change (who, from, to, why).
model BookingEvent {
  id          String         @id @default(cuid())
  bookingId   String
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  actorUserId String? // null for the system (the reconcile job)
  reason      String
  createdAt   DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  actor   User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
}

// Quotes (screens 14, 15; plan 5b). A quote is the agency's offer to one client: destinations,
// hotels and room options copied from the agency's own searches. One room per quote, like a
// booking in phase 1. Prices are the supplier's net total (what the agency would pay) and the
// agency's own selling price to its client. Every query is scoped by agencyId
// (src/server/quotes/quotes.ts).
enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  SELECTED
  BOOKED
}

enum QuoteLanguage {
  EN
  HE
}

enum MarkupType {
  PERCENT // markupValue in basis points: 1000 = 10%
  FIXED // markupValue in cents, per room
}

model Quote {
  id               String        @id @default(cuid())
  number           Int           @unique @default(autoincrement()) // shown as "Q-" + number
  agencyId         String
  createdById      String
  clientId         String?
  title            String        @default("")
  language         QuoteLanguage @default(EN)
  message          String        @default("")
  showCancellation Boolean       @default(true)
  markupType       MarkupType    @default(PERCENT)
  markupValue      Int           @default(0)
  adults           Int           @default(2)
  childAges        Int[]         @default([])
  status           QuoteStatus   @default(DRAFT)
  // The client link (plan 5c): an unguessable capability, made the first time the agent shares
  // the quote. It opens one quote read-only for the client (and lets them send selections);
  // it never signs anyone in. Kept to show and copy the same link again.
  shareToken       String?       @unique
  sentAt           DateTime?
  viewedAt         DateTime? // the client's last view
  viewCount        Int           @default(0)
  selectedAt       DateTime? // when the client last sent selections
  clientNote       String        @default("") // the client's note with the selections
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  agency    Agency      @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  createdBy User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  client    Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  stays     QuoteStay[]
  bookings  Booking[]

  @@index([agencyId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([agencyId, status, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([clientId])
}

// One destination of a quote, with its own dates.
model QuoteStay {
  id              String @id @default(cuid())
  quoteId         String
  destinationId   String // the region the agent searched (Destination.id)
  destinationName String
  checkin         String // YYYY-MM-DD
  checkout        String
  position        Int

  // The room the client chose here (plan 5c); cleared when that room is removed. The selling
  // price the client saw is kept with it, so a later price change shows as a difference.
  selectedRoomId    String? @unique
  selectedSellMinor Int?
  selectedCurrency  String?

  quote        Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  hotels       QuoteHotel[]
  selectedRoom QuoteRoom?   @relation("StaySelection", fields: [selectedRoomId], references: [id], onDelete: SetNull)
  bookings     Booking[]

  @@index([quoteId, position])
}

model QuoteHotel {
  id         String   @id @default(cuid())
  stayId     String
  propertyId String
  name       String
  city       String
  starRating Decimal? @db.Decimal(2, 1)
  agencyPick Boolean  @default(false) // "Agency pick" star
  position   Int

  stay  QuoteStay   @relation(fields: [stayId], references: [id], onDelete: Cascade)
  rooms QuoteRoom[]

  @@unique([stayId, propertyId])
  @@index([stayId, position])
}

// One room option: a copy of one rate of a search. The price-check token is never stored: a
// booking from a quote searches and checks the price again (plan 5d).
model QuoteRoom {
  id                String   @id @default(cuid())
  hotelId           String
  roomId            String
  rateId            String
  bedGroupId        String
  roomName          String
  bedDescription    String
  refundable        Boolean
  freeCancelUntil   String? // the supplier's last free-cancellation day, YYYY-MM-DD (hotel's calendar)
  clientCancelUntil String? // the date the client sees; never later than freeCancelUntil
  netMinor          Int // the supplier's inclusive total for the stay (BP5), never recomputed
  currency          String
  price             Json // PriceBreakdown as copied from the search (fees paid at the hotel, BP4)
  sellMinor         Int? // a price the agent typed; null = from the quote's markup
  position          Int
  createdAt         DateTime @default(now())

  hotel      QuoteHotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  selectedIn QuoteStay? @relation("StaySelection")

  @@unique([hotelId, rateId, bedGroupId])
  @@index([hotelId, position])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// "Join Apolles" (screen 02, plan 7): a travel business asks for access. Admin approves (creates
// the agency and its agent user) or rejects. No documents or card details are ever stored.
model AgencyApplication {
  id           String            @id @default(cuid())
  status       ApplicationStatus @default(PENDING)
  agencyName   String
  contactName  String
  email        String // lowercase
  phone        String
  country      String // ISO 3166-1 alpha-2
  website      String
  license      String            @default("") // IATA / TIDS / travel license, optional
  notes        String            @default("")
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  agencyId     String?           @unique // set on approval

  reviewedBy User?   @relation(fields: [reviewedById], references: [id], onDelete: Restrict)
  agency     Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([email, status])
}

// "Recent searches" on screen 07 (plan 8d): the agent's last searches (destination, dates and
// guests only), at most 5 per user. "Clear all" removes them.
model RecentSearch {
  id              String   @id @default(cuid())
  agencyId        String
  userId          String
  destinationId   String
  destinationName String
  checkin         String // YYYY-MM-DD
  checkout        String
  adults          Int
  childAges       Int[]
  createdAt       DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([agencyId])
}
