generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum PasswordTokenPurpose {
  SET
  RESET
}

enum LedgerEntryType {
  TOPUP_BANK
  HOLD
  HOLD_RELEASE
  CHARGE
  REFUND
  PAYOUT
  ADJUSTMENT
}

model Agency {
  id            String        @id @default(cuid())
  name          String
  country       String // ISO 3166-1 alpha-2
  status        AccountStatus @default(ACTIVE)
  bankRefNo     Int           @unique @default(autoincrement())
  bankReference String        @unique // e.g. "APL-1042"
  phone         String? // business phone, set by the agent on /settings (shown on vouchers)
  email         String? // business email, set by the agent on /settings (not a login email)
  createdAt     DateTime      @default(now())

  users         User[]
  ledgerEntries LedgerEntry[]
  logo          AgencyLogo?
  bookings      Booking[]

  @@index([createdAt, id])
}

// The agency's logo, one per agency (src/server/agency-profile.ts). The bytes are PNG or JPEG,
// checked from their own header on upload (src/lib/image-info.ts); never SVG.
model AgencyLogo {
  agencyId  String   @id
  mimeType  String // "image/png" | "image/jpeg"
  data      Bytes
  sizeBytes Int
  width     Int
  height    Int
  sha256    String
  updatedAt DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
}

model User {
  id                String        @id @default(cuid())
  agencyId          String?
  role              Role
  email             String        @unique // always stored lowercase (see normalizeEmail)
  name              String
  passwordHash      String?
  failedLogins      Int           @default(0)
  lockedUntil       DateTime?
  // When the last sign-in attempt slot was taken (database clock, set by reserveAttempt). A row
  // at MAX_FAILED_LOGINS with no lock and an old reservation was left by a crashed request.
  attemptReservedAt DateTime?
  totpSecret        String? // base32; set by startTotpEnrollment (admins only)
  // Set once the admin proved the authenticator works; until then the secret can be replaced.
  totpConfirmedAt   DateTime?
  // Last accepted TOTP time step: a code is accepted only for a later step (no reuse).
  totpLastUsedStep  Int?
  status            AccountStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())

  agency         Agency?         @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  sessions       Session[]
  passwordTokens PasswordToken[]
  ledgerEntries  LedgerEntry[]
  auditLogs      AuditLog[]
  bookings       Booking[]
  bookingEvents  BookingEvent[]

  @@index([agencyId])
}

model Session {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  userId         String
  expiresAt      DateTime
  // Admin sessions only: when the TOTP code was entered for this session. Null = not yet.
  totpVerifiedAt DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordToken {
  id        String               @id @default(cuid())
  tokenHash String               @unique
  userId    String
  purpose   PasswordTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LedgerEntry {
  id             String          @id @default(cuid())
  agencyId       String
  type           LedgerEntryType
  amountCents    Int
  currency       String          @default("USD")
  holdId         String?
  bookingRef     String?
  reason         String
  actorUserId    String?
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([agencyId, createdAt])
  @@index([holdId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId])
}

// Fixed-window request counters for rate limits (src/server/rate-limit.ts). One row per key
// and window; windowStart comes from the database clock. Keys hold an action and an IP, or a
// sha256 hash of an email, never a raw email. Rows older than 24 hours are pruned.
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int

  @@id([key, windowStart])
  @@index([windowStart])
}

// Every request to and response from a supplier (Expedia), for the site review and debugging
// (spec section 6, "supplier log"). Bodies have personal data masked (src/server/supplier/mask.ts)
// and are capped in size. Kept 90 days; the cleanup job comes with the background worker.
model SupplierCallLog {
  id                   String   @id @default(cuid())
  supplier             String // "expedia"
  method               String
  path                 String // path and query; never credentials
  status               Int? // null on a timeout or network error
  durationMs           Int
  affiliateReferenceId String?
  requestBody          Json?
  responseBody         Json?
  error                String? // "timeout" | "network" | null
  // Names (never values) of response fields the adapter did not know and dropped
  // (owner decision 2026-11-10, docs/decisions/2026-11-10-supplier-unknown-fields.md).
  unknownFields        String[] @default([])
  createdAt            DateTime @default(now())

  @@index([createdAt])
  @@index([affiliateReferenceId])
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// Background work (spec section 7: daily content refresh, reconciliation, emails, PDFs), run by
// the separate worker process (src/worker.ts). Claimed with FOR UPDATE SKIP LOCKED, so two
// workers never run the same job (src/server/jobs/queue.ts).
model Job {
  id         String    @id @default(cuid())
  kind       String
  payload    Json
  status     JobStatus @default(QUEUED)
  attempts   Int       @default(0)
  runAt      DateTime
  lockedAt   DateTime?
  lastError  String? // the error class and at most 500 characters, never a response body
  dedupeKey  String?   @unique
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status, runAt])
}

enum ContentSyncStatus {
  RUNNING
  DONE
  FAILED
}

// The local copy of Expedia's hotel list (spec section 7, "local hotel database"), refreshed
// daily from the catalog file (src/server/content/catalog-sync.ts). Only the countries in
// CONTENT_COUNTRIES are stored. Coordinates and star ratings are decimals, never floats.
model Property {
  id               String   @id // Expedia property id
  name             String
  city             String
  countryCode      String
  stateProvince    String?
  starRating       Decimal? @db.Decimal(2, 1)
  latitude         Decimal? @db.Decimal(9, 6)
  longitude        Decimal? @db.Decimal(9, 6)
  rank             Int?
  expediaCollect   Boolean
  active           Boolean  @default(true)
  catalogSeenRunId String
  updatedAt        DateTime @updatedAt

  @@index([active, expediaCollect, rank])
  @@index([countryCode, catalogSeenRunId])
}

// One run of a content sync job (catalog, regions, inactive), for auditing and for "since".
model ContentSyncRun {
  id         String            @id @default(cuid())
  kind       String
  status     ContentSyncStatus @default(RUNNING)
  startedAt  DateTime          @default(now())
  finishedAt DateTime?
  counts     Json?

  @@index([kind, status, startedAt])
}

// Destinations agents search by (cities and multi-city areas), from Rapid /regions, refreshed
// daily (src/server/content/regions-sync.ts). A prefix index on lower(name) for active rows is
// added in the migration's raw SQL.
model Destination {
  id            String   @id // Expedia region id
  name          String
  nameFull      String
  type          String // "city" | "multi_city_vicinity"
  countryCode   String
  propertyCount Int
  active        Boolean  @default(true)
  seenRunId     String
  updatedAt     DateTime @updatedAt

  @@index([countryCode, seenRunId])
}

// Which hotels are in which destination. No foreign key to Property: the two syncs run
// independently, and search joins only active Property rows.
model DestinationProperty {
  destinationId String
  propertyId    String

  @@id([destinationId, propertyId])
  @@index([propertyId])
}

// Hotel content (images, check-in, fees, policies) from Rapid /properties/content, cached for
// 24 hours; up to 7 days when Expedia is unavailable (src/server/content/content-cache.ts).
model PropertyContentCache {
  propertyId String   @id
  data       Json // PropertyContent (src/server/supplier/types.ts)
  fetchedAt  DateTime

  @@index([fetchedAt])
}

// A search an agent ran (plan 2b, task 6): the candidate hotels in rank order and how far the
// supplier calls got. Results are stored as a snapshot for 30 minutes, so filtering, sorting and
// paging never call Expedia again; the price is checked again before booking anyway. Every
// query is scoped by agencyId (no IDOR).
model SearchSnapshot {
  id           String        @id @default(cuid())
  agencyId     String
  userId       String
  query        Json
  candidateIds String[]
  nextIndex    Int           @default(0)
  createdAt    DateTime
  expiresAt    DateTime
  hotels       SearchHotel[]
  rates        SearchRate[]

  @@index([agencyId, createdAt])
  @@index([expiresAt])
}

// One priced hotel in a search snapshot: its cheapest total and all its offers (Offer[]).
model SearchHotel {
  snapshotId          String
  propertyId          String
  position            Int // rank order within the search ("recommended")
  name                String
  city                String
  starRating          Decimal?       @db.Decimal(2, 1)
  minTotalMinor       Int
  currency            String
  refundableAvailable Boolean
  offers              Json
  snapshot            SearchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, propertyId])
  @@index([snapshotId, position])
  @@index([snapshotId, minTotalMinor])
}

// One rate of a priced hotel in a search snapshot (plan 2c). The results filters (room name,
// free cancellation, price) match one rate on all of them, and the card shows the cheapest
// matching rate, so a hotel's "from" price is always a rate the agent can actually pick.
model SearchRate {
  snapshotId     String
  propertyId     String
  rateIndex      Int // position in SearchHotel.offers
  roomName       String // lowercased, for the room-name filter
  refundable     Boolean
  totalMinor     Int
  currency       String
  feesAtProperty Boolean // something is paid at the hotel on top of the total (BP4)
  snapshot       SearchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, propertyId, rateIndex])
  @@index([snapshotId, totalMinor])
}

// Booking states (spec section 5; plan 3). Changes go only through src/server/booking/states.ts,
// which updates conditionally inside a transaction and writes a BookingEvent row.
enum BookingStatus {
  DRAFT // guest details entered; nothing held, nothing sent
  PENDING_CONFIRMATION // money held; the supplier was asked (or its answer is not known yet)
  CONFIRMED // the supplier confirmed; the hold became a charge
  FAILED // the supplier refused, or reconciliation found no booking; the hold was released
  CANCEL_PENDING // the agent asked to cancel; waiting for the supplier
  CANCELLED // the supplier confirmed the cancellation; the refund is in the wallet
  CANCELLED_BY_SUPPLIER // cancelled by the supplier or the hotel (refund recorded by an admin)
  EXPIRED // a draft left too long; nothing was held
}

// One hotel booking of one agency (phase 1: one room). Money in integer minor units (USD).
// The price-check token and the supplier's links are server-only and never sent to a browser.
model Booking {
  id                      String        @id @default(cuid())
  reference               String        @unique // "APL-XXXXXXXX"; also the supplier's affiliate_reference_id (TR1)
  agencyId                String
  userId                  String
  status                  BookingStatus @default(DRAFT)
  snapshotId              String? // the search it came from (gone after cleanup)
  propertyId              String
  hotelName               String
  hotelCity               String
  roomId                  String
  roomName                String
  rateId                  String
  bedGroupId              String
  bedDescription          String
  checkin                 String // YYYY-MM-DD, the property's calendar date
  checkout                String
  adults                  Int
  childAges               Int[]
  leadGivenName           String
  leadFamilyName          String
  leadEmail               String
  leadPhone               String
  guests                  Json // [{ givenName, familyName }] for every guest, lead first
  refundable              Boolean
  totalMinor              Int // what the agency pays: the supplier's inclusive total (BP5)
  currency                String
  price                   Json // PriceBreakdown as last checked
  cancelPenalties         Json // CancelPenalty[]
  nonrefundableDateRanges Json
  priceCheckToken         String // from the search snapshot; server-only
  bookToken               String? // from the last price check; server-only
  priceCheckedAt          DateTime?
  previousTotalMinor      Int? // set when the last price check changed the price
  holdId                  String?
  supplierItineraryId     String?
  supplierRoomId          String?
  supplierLinks           Json? // retrieve and cancel hrefs from the supplier; server-only
  hotelConfirmationId     String?
  cancelChargeMinor       Int?
  refundMinor             Int?
  failureReason           String?
  reconcileAttempts       Int           @default(0)
  lastNotFoundAt          DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  confirmedAt             DateTime?
  cancelledAt             DateTime?

  agency Agency         @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  user   User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  events BookingEvent[]

  @@index([agencyId, createdAt])
  @@index([agencyId, status, checkin])
  @@index([status, updatedAt])
}

// The audit trail of a booking: one row per state change (who, from, to, why).
model BookingEvent {
  id          String         @id @default(cuid())
  bookingId   String
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  actorUserId String? // null for the system (the reconcile job)
  reason      String
  createdAt   DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  actor   User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
}
