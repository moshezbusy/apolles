# Copy to .env on the server (deploy/.env for docker compose). Never commit the real file.

# Required. At least 24 characters, long and random, e.g.:  openssl rand -hex 32
# The service refuses to start with this placeholder.
APOLLES_API_KEY=change-me-to-a-long-random-string-48-chars
PORT=8080

# HOST is deliberately not set here.
# In Docker the image listens on 0.0.0.0 so the CRM container can reach it;
# a line "HOST=127.0.0.1" in this file would override that and make the
# service reachable only from inside its own container.
# Running WITHOUT Docker the default is 127.0.0.1 (this machine only);
# set HOST yourself only if you know you need something else.

# Where bookings are kept (one JSON file). Required when NODE_ENV=production.
# docker compose sets it to /data/bookings/bookings.json already.
# BOOKINGS_FILE=/data/bookings/bookings.json

# Optional: https webhook (e.g. n8n) called when a person has to look at
# something: a booking in NEEDS_REVIEW, a cancel with an unknown outcome, a
# final price above the approved one, an audit log that cannot be written.
# The message holds references only, no guest data.
# ALERT_WEBHOOK_URL=https://

# Optional: audit log. Days to keep the daily files (default 730) and the
# largest request/response body kept per entry, in KB (default 256).
# AUDIT_RETENTION_DAYS=730
# AUDIT_MAX_BODY_KB=256

# Omnibees (from Omnibees after the agreement)
OMNIBEES_BASE_URL=
OMNIBEES_USERNAME=
OMNIBEES_PASSWORD=

# Dingus (from Dingus after the agreement)
DINGUS_BASE_URL=
DINGUS_USERNAME=
DINGUS_PASSWORD=

# Hotelbeds APItude (developer.hotelbeds.com > Dashboard > My API keys)
# Test key works on https://api.test.hotelbeds.com only.
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
