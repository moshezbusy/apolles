# Every setting the app reads, with what it is for. Copy the names into your hosting provider
# or local shell and fill in your own values. Never commit real values.
# "Production" below means APP_ENV=production: the server refuses to start there when a setting
# marked "required in production" is missing or wrong, and lists what to fix.

# ---- Which deployment this is ----

# staging = the demo server; production = the live system. A built server (NODE_ENV=production)
# refuses to start unless this is exactly "staging" or "production". Leave it unset only on a
# developer machine and in tests.
APP_ENV=

# Set by the tooling, not by hand: "production" in a built server, "development" for
# `pnpm dev`, "test" in tests.
# NODE_ENV=production

# ---- Database ----

# PostgreSQL connection. Required everywhere. Development and tests use their own local
# databases, never the staging or production one.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/apolles_dev

# ---- Web address and proxy ----

# Public address of the site, used in email links (set password, reset, quotes). Required in
# production, where it must start with https://.
APP_URL=http://localhost:3000

# Rate limits (sign-in, admin code, forgot/set password, join) count requests per client IP.
# How many proxies in front of the app append to X-Forwarded-For (the hosting provider's proxy
# appends the real client IP). The client IP is taken that many entries from the right; entries
# further left are sent by the client and can be faked. 0 = ignore X-Forwarded-For: the client
# IP is then "unknown" and all visitors share one counter (x-real-ip is never used: a client
# can set it itself). Must match the real setup: too high lets clients pick their own IP, too
# low counts every visitor as the proxy. In production the log says "client IP unknown" when
# this is wrong. Default 1.
TRUSTED_PROXY_HOPS=1

# ---- Email ----

# Who sends email: console = print recipient and subject only (development and tests);
# postmark = real sending (required in production); staging-log = staging only, writes each
# email (including set-password and reset links) as one JSON line to the server log.
EMAIL_PROVIDER=console
# The sender address, "Name <address>" or just the address. Required with postmark.
EMAIL_FROM=no-reply@example.com
# Postmark's server token. Required with postmark. A secret.
POSTMARK_SERVER_TOKEN=replace-me
# Development and tests only: a file where the console adapter appends full emails, so the
# browser tests can read the links. Never in production.
EMAIL_SINK_FILE=

# Where alerts for the admin are emailed: locked accounts, new agency applications, bookings
# that need attention. Required in production.
ADMIN_ALERT_EMAIL=alerts@example.com

# ---- Sign-in security ----

# Encrypts the admin's authenticator (two-step) key in the database. 32 random bytes written
# as base64: make one with `openssl rand -base64 32`. Required in production. A secret: keep a
# safe copy, because without it the stored key cannot be read and the admin's two-step setup
# has to be reset. When it is not set (development, tests) the key is stored as it is.
TOTP_ENCRYPTION_KEY=

# The first admin, created by `pnpm db:seed`.
SEED_ADMIN_EMAIL=admin@example.com

# ---- Hotel supplier (Expedia Rapid) ----

# Unset or "expedia" = Expedia. "fake" = made-up hotels, prices and bookings with a banner on
# every page: development, the browser tests and the staging demo only. Refused in production.
SUPPLIER_MODE=
# Expedia's API key and shared secret. Required in production. Secrets. Agents and developers
# only ever hold TEST credentials.
EXPEDIA_API_KEY=
EXPEDIA_SHARED_SECRET=
# Expedia's address: https://test.ean.com/v3 (test) or https://api.ean.com/v3 (live). Outside
# production only the test address is accepted, and it is the default. Production must set it.
EXPEDIA_BASE_URL=https://test.ean.com/v3
# The payer's name and address sent to Expedia with every booking. Required in production
# (the postal code is optional).
EXPEDIA_BILLING_GIVEN_NAME=
EXPEDIA_BILLING_FAMILY_NAME=
EXPEDIA_BILLING_ADDRESS_LINE1=
EXPEDIA_BILLING_CITY=
EXPEDIA_BILLING_POSTAL_CODE=
# The https link to the supplier's terms, shown to the agent before booking. Hidden when unset.
SUPPLIER_TERMS_URL=

# ---- Second supplier: Hotelbeds through the supplier layer (owner decision 2026-11-23) ----

# Which suppliers search and book. Unset = the main supplier only (as SUPPLIER_MODE says), as
# before. "expedia,hotelbeds" or "fake,hotelbeds" adds Hotelbeds for the hotels whose link an
# admin approved on /admin/hotel-mapping. Exactly one of "expedia" and "fake"; it must agree with
# SUPPLIER_MODE when that is set. "fake" is refused in production.
SUPPLIERS=
# The supplier layer service (on the VPS: http://apolles-suppliers:8080) and its x-api-key
# (24 characters or more, a secret). Required when SUPPLIERS names hotelbeds. Outside production
# only the layer's TEST answers are used; in production only its production answers.
SUPPLIER_LAYER_URL=
SUPPLIER_LAYER_API_KEY=
# TEMPORARY, STAGING ONLY: until Hotelbeds gives a USD account, prices in this one currency are
# converted to USD at this fixed rate (USD for 1 unit, e.g. 1.0850) plus a safety margin in
# percent (default 2), always rounded up. The server refuses to start with any of these set in
# production; production keeps only USD Hotelbeds rates. Remove them once the USD account exists.
HOTELBEDS_FX_CURRENCY=
HOTELBEDS_FX_TO_USD=
HOTELBEDS_FX_MARGIN_PERCENT=

# ---- Shown to agents ----

# Apolles support contact on the booking pages. Shown as "not set yet" when unset.
APOLLES_SUPPORT_EMAIL=
APOLLES_SUPPORT_PHONE=

# Bank transfer details on the agent balance page (missing ones are hidden).
BANK_DETAILS_BENEFICIARY=Example Ltd
BANK_DETAILS_BANK_NAME=Example Bank
BANK_DETAILS_ACCOUNT_NUMBER=000000
BANK_DETAILS_IBAN=XX00EXAMPLE0000000000
BANK_DETAILS_SWIFT=EXAMPLEX

# ---- Tests and tooling only ----

# Database for the Playwright browser test (must be local and end in _e2e).
E2E_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/apolles_e2e
# Set by the CI system itself; the browser tests then refuse a forgotten "only this test" mark.
# CI=true

# ---- Staging server only (deploy/staging, see its README) ----

# The staging database container's password, generated on the server. A secret.
# POSTGRES_PASSWORD=
# Optional paths for the staging auto-update script (defaults in deploy/staging/auto-update.sh).
# APOLLES_STAGING_DIR=
# APOLLES_STAGING_LOCK=
# APOLLES_STAGING_DEPLOYED=
# APOLLES_STAGING_FAILED=
