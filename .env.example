# Copy values into your hosting provider / local shell. Never commit real values.
# Non-production database only (local development uses its own database).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/apolles_dev

# Where account-lockout alerts are emailed (3 failed sign-ins). Required in every environment.
ADMIN_ALERT_EMAIL=alerts@example.com

# Email (owner-approved addition 2026-11-09)
# console = print to/subject only (dev/test); postmark = real sending
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
POSTMARK_SERVER_TOKEN=replace-me
# Public base URL used in set/reset password links (https in production)
APP_URL=http://localhost:3000
# Dev/test only: file where the console adapter appends full emails (never in production)
EMAIL_SINK_FILE=

# First admin created by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@example.com

# Bank transfer details shown to agents on /balance (missing ones are hidden)
BANK_DETAILS_BENEFICIARY=Example Ltd
BANK_DETAILS_BANK_NAME=Example Bank
BANK_DETAILS_ACCOUNT_NUMBER=000000
BANK_DETAILS_IBAN=XX00EXAMPLE0000000000
BANK_DETAILS_SWIFT=EXAMPLEX

# Optional: database for the Playwright e2e test (must be local and end in _e2e)
E2E_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/apolles_e2e

# Rate limits (sign-in, admin code, forgot/set password) count requests per client IP.
# How many proxies in front of the app append to X-Forwarded-For (the hosting provider's proxy
# appends the real client IP). The client IP is taken that many entries from the right; entries
# further left are sent by the client and can be faked. 0 = ignore X-Forwarded-For (use
# x-real-ip). Must match the real setup: too high lets clients pick their own IP, too low counts
# every visitor as the proxy. Default 1.
TRUSTED_PROXY_HOPS=1
